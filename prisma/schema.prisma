// Placeholder: prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// The tenant root — one row per company using this product. Every user and
// every piece of business data (clients, invoices, tasks, etc.) belongs to
// exactly one Organization, and every query in the app must filter by it so
// no company can ever see another company's data.
model Organization {
  id        String   @id @default(cuid())
  name      String
  gstin     String?
  address   String?
  email     String?
  createdAt DateTime @default(now())

  users     User[]
  clients   Client[]
  invoices  Invoice[]
  tasks     Task[]
}

enum Role {
  FOUNDER
  MANAGER
  EMPLOYEE
  CLIENT
}

enum PaymentStatus {
  PAID
  PENDING
  OVERDUE
  PARTIAL
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum ExpenseCategory {
  SALARY
  RENT
  UTILITIES
  SOFTWARE
  MARKETING
  TRAVEL
  OFFICE_SUPPLIES
  PROFESSIONAL_FEES
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum AttendanceStatus {
  ON_TIME
  LATE
  ABSENT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
}

enum LeaveType {
  SICK
  CASUAL
  EARNED
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  employeeId   String
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EMPLOYEE)
  managerId    String?
  manager      User?    @relation("ManagerToEmployee", fields: [managerId], references: [id])
  reports      User[]   @relation("ManagerToEmployee")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Forces the "change password" screen on first login (set true whenever a
  // Founder/Manager creates the account with a temporary password).
  mustChangePassword Boolean @default(true)

  // Employment details used to generate the offer letter PDF. Set by
  // whoever created the account; the employee themselves cannot edit these.
  designation  String?
  salary       Decimal?
  joiningDate  DateTime?

  // Set only for role=CLIENT accounts — links a client-portal login back to
  // the Client record it's allowed to see. Null for all staff accounts.
  portalClientId String? @unique
  portalClient   Client? @relation("ClientPortalUser", fields: [portalClientId], references: [id])

  clients      Client[]  @relation("ClientOwner")
  clientDocumentsUploaded ClientDocument[]
  invoices     Invoice[]
  meetings     Meeting[]

  tasksGiven      Task[]    @relation("TaskAssignedBy")
  tasksReceived   Task[]    @relation("TaskAssignedTo")
  subtasksGiven   SubTask[] @relation("SubTaskAssignedBy")
  subtasksReceived SubTask[] @relation("SubTaskAssignedTo")
  expenses        Expense[]
  passwordResetTokens PasswordResetToken[]
  profile         Profile?
  ticketsRaised   Ticket[] @relation("TicketRaisedBy")
  ticketsHandled  Ticket[] @relation("TicketHandledBy")
  attendanceDays  AttendanceDay[]
  activityPings   ActivityPing[]
  leadsAssigned   Lead[] @relation("LeadAssignedTo")
  leadsCreated    Lead[] @relation("LeadCreatedBy")
  holidaysCreated HolidayEntry[]
  leaveRequests   LeaveRequest[] @relation("LeaveRequestedBy")
  leavesReviewed  LeaveRequest[] @relation("LeaveReviewedBy")

  @@unique([organizationId, employeeId])
}

model Client {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name      String
  gstin     String?
  email     String?
  phone     String?
  address   String?
  ownerId   String
  owner     User      @relation("ClientOwner", fields: [ownerId], references: [id])
  portalUser User?    @relation("ClientPortalUser")
  documents ClientDocument[]
  invoices  Invoice[]
  meetings  Meeting[]
  leads     Lead[]
  tasks     Task[]
  createdAt DateTime  @default(now())
}

// Files uploaded against a client — contracts, agreements, ID proofs, etc.
// Stored as base64 directly in the database (no external storage
// configured); fine for occasional documents, not bulk file storage.
model ClientDocument {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name         String
  mimeType     String
  data         String   @db.Text
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

// Prospective clients being pursued — can later convert into a real Client.
model Lead {
  id               String     @id @default(cuid())
  name             String
  company          String?
  email            String?
  phone            String?
  source           String?
  status           LeadStatus @default(NEW)
  notes            String?
  assignedToId     String
  assignedTo       User       @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  createdById      String
  createdBy        User       @relation("LeadCreatedBy", fields: [createdById], references: [id])
  convertedClientId String?   @unique
  convertedClient  Client?    @relation(fields: [convertedClientId], references: [id])
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Invoice {
  id          String        @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  invoiceNo   String
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id])
  raisedById  String
  raisedBy    User          @relation(fields: [raisedById], references: [id])
  description String?
  amount      Decimal
  gstRate     Decimal       @default(18)
  gstAmount   Decimal
  cgstAmount  Decimal       @default(0)
  sgstAmount  Decimal       @default(0)
  igstAmount  Decimal       @default(0)
  interState  Boolean       @default(false)
  sacCode     String        @default("998314")
  natureOfSupply String     @default("B2B")
  placeOfSupply  String?
  totalAmount Decimal
  status      PaymentStatus @default(PENDING)
  dueDate     DateTime
  paidDate    DateTime?
  paidAmount  Decimal       @default(0)
  reminderSentAt DateTime?
  // Unguessable token so clients can view/download the invoice without logging in.
  publicToken String        @unique @default(cuid())
  createdAt   DateTime      @default(now())

  @@unique([organizationId, invoiceNo])
}

model Meeting {
  id             String    @id @default(cuid())
  title          String
  clientId       String?
  client         Client?   @relation(fields: [clientId], references: [id])
  hostId         String
  host           User      @relation(fields: [hostId], references: [id])
  scheduledAt    DateTime
  notes          String?
  meetingLink    String?
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())
}

// A Task is handed down from a Founder to a Manager.
model Task {
  id           String     @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  title        String
  description  String?
  status       TaskStatus @default(PENDING)
  dueDate      DateTime?
  assignedById String
  assignedBy   User       @relation("TaskAssignedBy", fields: [assignedById], references: [id])
  assignedToId String
  assignedTo   User       @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  // Which client/brand this work is for — optional, for internal-only tasks.
  clientId     String?
  client       Client?    @relation(fields: [clientId], references: [id])
  subtasks     SubTask[]
  completedAt  DateTime?
  reminderSentAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// A SubTask is handed down from a Manager to an Employee, under a parent Task.
model SubTask {
  id           String     @id @default(cuid())
  title        String
  description  String?
  status       TaskStatus @default(PENDING)
  dueDate      DateTime?
  taskId       String
  task         Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignedById String
  assignedBy   User       @relation("SubTaskAssignedBy", fields: [assignedById], references: [id])
  assignedToId String
  assignedTo   User       @relation("SubTaskAssignedTo", fields: [assignedToId], references: [id])
  completedAt  DateTime?
  reminderSentAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// Company expenses, logged by Founders, used for the finances/expense tracker.
model Expense {
  id          String          @id @default(cuid())
  title       String
  category    ExpenseCategory @default(OTHER)
  amount      Decimal
  expenseDate DateTime
  notes       String?
  addedById   String
  addedBy     User            @relation(fields: [addedById], references: [id])
  createdAt   DateTime        @default(now())
}

// Single-use, expiring tokens for the "forgot password" flow.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Personal details every user fills in about themselves — separate from
// employment/role data, which only Founders/Managers control.
model Profile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone                 String?
  address               String?
  dateOfBirth           DateTime?
  bio                   String?
  emergencyContactName  String?
  emergencyContactPhone String?
  // KYC — Aadhaar number and a scanned copy, collected during first-login
  // onboarding. The document is stored as a base64 data URL directly in the
  // database (no external file storage configured); fine for occasional
  // small ID scans, not meant for large files.
  aadharNumber          String?
  idDocumentData        String?   @db.Text
  idDocumentName         String?
  idDocumentMimeType     String?
  // Bank details for salary payment — provided by the employee themselves,
  // visible only to the employee and Founders (payroll).
  bankAccountHolderName String?
  bankAccountNumber     String?
  bankIfsc              String?
  bankName              String?
  completedAt           DateTime?
  updatedAt             DateTime  @updatedAt
  createdAt             DateTime  @default(now())
}

// Support tickets — any user can raise one; Founders (and Managers, for
// their own reports) triage and resolve them.
model Ticket {
  id           String       @id @default(cuid())
  title        String
  description  String
  status       TicketStatus @default(OPEN)
  raisedById   String
  raisedBy     User         @relation("TicketRaisedBy", fields: [raisedById], references: [id])
  handledById  String?
  handledBy    User?        @relation("TicketHandledBy", fields: [handledById], references: [id])
  response     String?
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}
// One row per employee per calendar day — clock-in/out, break, and computed status.
model AttendanceDay {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id])
  date              DateTime          // stored at midnight local time — one row per user per day
  clockInAt         DateTime?
  clockOutAt        DateTime?
  breakStartAt      DateTime?
  breakEndAt        DateTime?
  totalBreakSeconds Int               @default(0)
  status            AttendanceStatus?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([userId, date])
}

// Heartbeat pings sent by the browser while the employee is actively using
// the mouse/keyboard. Gaps between pings longer than the idle threshold are
// treated as "missing" activity for that stretch of the shift.
model ActivityPing {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  timestamp DateTime @default(now())

  @@index([userId, timestamp])
}

// Company-wide holidays — set by Founders/Managers, visible to everyone.
model HolidayEntry {
  id          String   @id @default(cuid())
  name        String
  date        DateTime
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

// Leave applications — anyone can apply for themselves; Founders/Managers
// (for their own visible team) approve or reject.
model LeaveRequest {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation("LeaveRequestedBy", fields: [userId], references: [id])
  leaveType    LeaveType   @default(CASUAL)
  startDate    DateTime
  endDate      DateTime
  reason       String?
  status       LeaveStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?       @relation("LeaveReviewedBy", fields: [reviewedById], references: [id])
  reviewNote   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}
